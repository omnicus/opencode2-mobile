{
  "name": "@opencode2-mobile/opencode-adapter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run src",
    "test:integration": "tsc -p tsconfig.integration.json && vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@opencode/client": "2.0.16"
  },
  "devDependencies": {
    "@opencode2-mobile/test-fixtures": "workspace:*",
    "@types/node": "26.0.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
