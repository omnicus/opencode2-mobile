{
  "name": "@opencode2-mobile/mobile",
  "version": "0.1.4",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "android": "expo run:android",
    "build": "expo export --platform all --output-dir dist",
    "doctor": "expo-doctor",
    "go": "expo start --go",
    "go:tailscale": "REACT_NATIVE_PACKAGER_HOSTNAME=$(tailscale ip -4) expo start --go --lan",
    "ios": "expo run:ios",
    "native:generate": "expo prebuild",
    "start": "expo start --dev-client",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@noble/ciphers": "1.0.0",
    "@opencode2-mobile/notification-protocol": "workspace:*",
    "@opencode2-mobile/opencode-adapter": "workspace:*",
    "@react-navigation/native": "7.3.17",
    "@react-navigation/native-stack": "7.18.9",
    "@tanstack/react-query": "5.102.2",
    "expo": "~54.0.37",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-local-authentication": "~17.0.9",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.20",
    "js-base64": "3.7.8",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-reanimated": "4.1.7",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.17",
    "expo-doctor": "1.20.2",
    "jest-expo": "~54.0.18",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.3"
  },
  "jest": {
    "preset": "jest-expo"
  }
